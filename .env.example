# Copie para .env e ajuste conforme a sua instalação.
# O .env é ignorado pelo Git e nunca deve ser versionado.

# Conexão com o banco
DB_URL=jdbc:mysql://localhost:3306/todolist?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=troque-esta-senha

# Chave de assinatura dos tokens JWT. Mínimo de 32 caracteres.
# Se ficar em branco, a aplicação gera uma chave aleatória a cada reinício:
# funciona para desenvolvimento, mas invalida os tokens a cada restart.
JWT_SECRET=

# Validade do token, em segundos (padrão: 24 horas)
JWT_EXPIRACAO_SEGUNDOS=86400

# Porta da aplicação
SERVER_PORT=8080
