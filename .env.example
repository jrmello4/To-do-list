# Copie para .env e ajuste conforme a sua instalação.
# O .env é ignorado pelo Git e nunca deve ser versionado.

# Conexão com o banco
DB_URL=jdbc:mysql://localhost:3306/todolist?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=troque-esta-senha

# Chave de assinatura dos tokens JWT. Mínimo de 32 caracteres.
# Se ficar em branco, a aplicação gera uma chave aleatória a cada reinício:
# funciona para desenvolvimento, mas invalida os tokens a cada restart.
JWT_SECRET=

# Validade do token, em segundos (padrão: 24 horas)
JWT_EXPIRACAO_SEGUNDOS=86400

# Porta da aplicação. Os serviços de hospedagem costumam injetar PORT, que
# tem precedência sobre esta.
SERVER_PORT=8080

# ------------------------------------------------------- Entrada e limites
# Teto de tentativas de senha erradas antes de a origem passar a receber 429,
# e por quanto tempo a contagem vale. O teto por conta corta o laço contra uma
# conta específica; o por IP é o que segura o laço em si. Contar por e-mail,
# sem o IP, deixaria qualquer um trancar a conta de qualquer pessoa.
LOGIN_MAX_POR_IP=20
LOGIN_MAX_POR_CONTA=8
LOGIN_JANELA_MINUTOS=15

# Como descobrir o IP de quem chamou. Atrás de um proxy ou de um serviço de
# hospedagem, deixe framework: sem isso todo mundo chega com o endereço do
# proxy e o limite acima tranca todas as contas de uma vez. Servindo direto,
# sem proxy nenhum na frente, use none — senão o cabeçalho pode ser forjado.
FORWARD_HEADERS_STRATEGY=framework

# Teto do corpo de uma requisição, em bytes (padrão: 10 MB). Existe porque o
# limite de 5000 itens da importação só é conferido depois de o JSON inteiro
# estar em memória — tarde demais para proteger a aplicação.
LIMITE_CORPO_BYTES=10485760

# Perfil ativo. Com dev, o Hibernate registra no log toda consulta que emite;
# em produção isso é CPU gasta formatando SQL e log que esconde o que importa.
# SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------- Lembretes
# Liga a varredura de hora em hora que envia o resumo diário. Deixe em uma
# única instância: com duas, o mesmo resumo sai duas vezes.
LEMBRETES_ATIVOS=false

# Servidor de e-mail. Comentadas de propósito: SPRING_MAIL_HOST definida como
# string vazia conta como definida e ligaria o envio real sem servidor nenhum
# atrás. Enquanto ela não existir, o lembrete só vai para o log.
# SPRING_MAIL_HOST=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# LEMBRETE_REMETENTE=nao-responda@todolist.local
